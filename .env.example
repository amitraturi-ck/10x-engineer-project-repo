# ==========================================================
# PromptLab Environment Configuration
# ----------------------------------------------------------
# This is a sample configuration file.
#
# For local development:
#   1. Copy this file to `.env`
#   2. Replace placeholder values with real credentials
#
# In production:
#   Environment variables should be provided securely
#   via Docker, CI/CD secrets, or a cloud secret manager.
# ==========================================================


# ======================
# Application Settings
# ======================

ENVIRONMENT=development
PYTHONUNBUFFERED=1


# ======================
# OpenAI Configuration
# ======================

# Required: Set your actual OpenAI API key
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Override default model
OPENAI_MODEL=gpt-4o-mini


# ======================
# Database Configuration
# ======================

# Used by backend application
DATABASE_URL=postgresql://promptlab:promptlab@db:5432/promptlab

# Used by PostgreSQL container
POSTGRES_USER=promptlab
POSTGRES_PASSWORD=promptlab
POSTGRES_DB=promptlab
