client = TestClient(app)

class TestHealthCheck:
    """Tests for health check endpoint."""
    
    def test_health_check_returns_healthy(self):
        """Health check should return healthy status."""
        response = client.get("/health")
        assert response.status_code == 200
        assert response.json()["status"] == "healthy"

class TestPrompts:
    """Tests for prompt endpoints."""
    
    def test_create_prompt_success(self):
        """Creating a valid prompt should succeed."""
        response = client.post(
            "/prompts",
            json={
                "title": "Test",
                "content": "This is a test prompt with enough content",
            }
        )
        assert response.status_code == 201
        assert response.json()["title"] == "Test"
    
    def test_create_prompt_invalid_content(self):
        """Creating prompt with short content should fail."""
        response = client.post(
            "/prompts",
            json={"title": "Test", "content": "short"}
        )
        assert response.status_code == 400
        assert "least 10 characters" in response.json()["detail"]
    
    def test_get_prompt_not_found(self):
        """Getting non-existent prompt should return 404."""
        response = client.get("/prompts/invalid_id")
        assert response.status_code == 404
        assert "not found" in response.json()["detail"]
